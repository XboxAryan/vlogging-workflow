# Vlogging Workflow Environment Variables
# Copy this file to .env and fill in your values

# OpenRouter API Key (FREE - get from openrouter.ai/keys)
# This is the default provider - works with free models
OPENROUTER_API_KEY=your-openrouter-key-here

# Alternative: Anthropic API Key (get from console.anthropic.com)
# Only needed if you set provider: "anthropic" in config.yaml
# ANTHROPIC_API_KEY=your-anthropic-key-here
